title: Sequence – Record a collected waste line (UC-B steps 3–4)
config:
  theme: base
  themeVariables:
    fontFamily: Helvetica, Arial, sans-serif
    fontSize: 14px
    actorBkg: "#e3efe7"
    actorBorder: "#2e5a40"
    actorTextColor: "#1f2a24"
    actorLineColor: "#8b958f"
    signalColor: "#1f2a24"
    signalTextColor: "#1f2a24"
    activationBkgColor: "#d6e8dc"
    activationBorderColor: "#2e5a40"
    labelBoxBkgColor: "#fff4d6"
    labelBoxBorderColor: "#9a7b1c"
    labelTextColor: "#1f2a24"
    loopTextColor: "#1f2a24"
    noteBkgColor: "#fffbe6"
