---
title: Activity – Plan a collection (UC-A, manager)
config:
  theme: base
  themeVariables:
    fontFamily: Helvetica, Arial, sans-serif
    fontSize: 14px
    lineColor: "#3d4a42"
    primaryTextColor: "#1f2a24"
    edgeLabelBackground: "#ffffff"
  flowchart:
    curve: basis
    nodeSpacing: 34
    rankSpacing: 34
---
flowchart TD
  start(( )):::startN --> A1[Open the Collections page<br/>and click “New collection”]:::manager
  A1 --> S1[Show the blank form<br/>points + active centers]:::system
  S1 --> A2[Select a<br/>collection point]:::manager
  A2 --> D1{Point linked<br/>to a center?}:::decision

  D1 -- yes --> S2[Pre-select the center<br/>from collection_point.center_id]:::system
  D1 -- "no (4a)" --> S3[Show inline message<br/>“no treatment center”]:::system
  S3 --> A3[Pick an active<br/>center manually]:::manager

  S2 --> A4[Choose date, driver<br/>and vehicle plate]:::manager
  A3 --> A4
  A4 --> A5[Click “Submit”]:::manager
  A5 --> D2{Date in<br/>the past?}:::decision
  D2 -- "yes (5a)" --> S4[Refuse: ask for<br/>a valid date]:::system
  S4 --> A4

  D2 -- no --> D3{Driver already<br/>booked that day?}:::decision
  D3 -- "yes (5b)" --> S5[Show warning<br/>“driver already booked”]:::system
  S5 --> D4{Manager<br/>confirms?}:::decision
  D4 -- "no, other driver" --> A4
  D4 -- yes --> S6
  D3 -- no --> S6[Insert row in collection<br/>with status planned]:::system
  S6 --> S7[Show the collection<br/>in the list and in<br/>the drivers' rounds]:::system
  S7 --> stop((( ))):::endN

  classDef manager fill:#ffffff,stroke:#1f2a24,stroke-width:1.5px,color:#1f2a24,rx:10,ry:10
  classDef system fill:#e3efe7,stroke:#2e5a40,stroke-width:1.5px,color:#1f2a24
  classDef decision fill:#fff4d6,stroke:#9a7b1c,stroke-width:1.5px,color:#1f2a24
  classDef startN fill:#1f2a24,stroke:#1f2a24
  classDef endN fill:#1f2a24,stroke:#1f2a24
